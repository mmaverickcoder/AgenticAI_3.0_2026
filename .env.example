# Copy this file to `.env` in the same folder (repo root, or any class/weekend
# folder that needs its own) and fill in only the keys you actually use.
# `.env` is git-ignored everywhere in this repo -- `.env.example` is the only
# variant that gets committed, so real keys never end up in git history.
#
# Every script/notebook in this course loads keys the same way:
#   from dotenv import load_dotenv
#   load_dotenv()
#   os.environ["GROQ_API_KEY"]   # or os.environ.get(...) if optional

# ---- Free / low-friction providers -- signup only, no card required -------
GROQ_API_KEY=
OPENROUTER_API_KEY=

# ---- Paid providers ---------------------------------------------------------
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# ---- LangSmith tracing (optional, used from the LangChain weekends on) -----
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
